# ===========================================================================
# Polymarket BTC 5-min Trading Bot — configuration
# Copy to ".env" and fill in. NEVER commit your real .env.
# ===========================================================================

# --- Execution mode --------------------------------------------------------
# Master safety switch. Bot only sends REAL orders when this is exactly "true".
# Anything else => dry-run (logs intended orders, no funds at risk).
ENABLE_LIVE=false

# --- Polymarket / CLOB credentials (only needed for live trading) ----------
# Polygon wallet private key that holds USDC + has approved Polymarket.
POLYMARKET_PRIVATE_KEY=
# Polymarket CLOB API host (default is fine).
CLOB_HOST=https://clob.polymarket.com
# Polygon chain id (137 = mainnet).
CHAIN_ID=137
# Optional: signature type for proxy/email wallets (0 = EOA, 1 = email/magic, 2 = browser proxy)
SIGNATURE_TYPE=0
# Optional: funder/proxy address when SIGNATURE_TYPE != 0
POLYMARKET_FUNDER_ADDRESS=

# --- Gamma API (market discovery) ------------------------------------------
GAMMA_HOST=https://gamma-api.polymarket.com
# Keyword used to find the recurring BTC up/down market on Gamma.
MARKET_QUERY=Bitcoin Up or Down

# --- Price feed ------------------------------------------------------------
# Public spot price source for the momentum signal.
PRICE_FEED_URL=https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT

# --- Strategy parameters ---------------------------------------------------
# Lookback (seconds) for momentum return.
MOMENTUM_LOOKBACK_SEC=60
# Scaling factor: a |return| of this size maps to ~0.76 momentum signal.
MOMENTUM_SCALE=0.0008
# Weight of momentum vs order-book imbalance (0..1). 1.0 = momentum only.
MOMENTUM_WEIGHT=0.6
# Minimum model edge over market price required to trade (probability points).
MIN_EDGE=0.05
# Minimum model confidence (0..1) to take a position.
MIN_CONFIDENCE=0.15
# Only act inside the last N seconds of the 5-min window (closer = sharper signal).
DECISION_WINDOW_SEC=90

# --- Risk management -------------------------------------------------------
# USDC notional per trade.
STAKE_USDC=5
# Max concurrent open notional (USDC).
MAX_OPEN_USDC=20
# Max trades per UTC day.
MAX_TRADES_PER_DAY=50
# Don't buy a token priced above this (avoid paying ~1.0 for near-certain).
MAX_PRICE=0.95
# Don't buy below this (avoid lottery longshots).
MIN_PRICE=0.05

# --- Loop ------------------------------------------------------------------
# Seconds between polls of price + market state.
POLL_INTERVAL_SEC=5
LOG_LEVEL=INFO
